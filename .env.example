APP_NAME="SPPD Elektronik Kota Kendari"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8004

# Isi dengan URL tunnel Cloudflare KHUSUS Vite (port 5176)
# Jalankan di terminal laptop: cloudflared tunnel --url http://localhost:5176
# Copy URL hasilnya ke sini, contoh: https://vite-random-name.trycloudflare.com
# Kosongkan jika hanya akses dari localhost
VITE_TUNNEL_URL=

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=db_sppd_update
DB_USERNAME=user
DB_PASSWORD=icangg05@2002

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Gate kesehatan queue: tolak pembuatan SPPD jika worker queue tidak berjalan.
# QUEUE_HEALTH_ENABLED=false untuk mematikan gate. MAX_STALENESS = ambang basi heartbeat (detik).
QUEUE_HEALTH_ENABLED=true
QUEUE_HEALTH_MAX_STALENESS=180

# ===== Tanda Tangan Elektronik (TTE) Configuration =====
E_SIGN_PROVIDER=local_proxy
E_SIGN_API_ENDPOINT=http://103.85.5.99
E_SIGN_AUTH_BASIC=ZXNwcGQ6TUEzNDVnRmJCR0hUTWRkeDdlVXI=
E_SIGN_TIMEOUT=30
PDF_STORAGE_DISK=public
TTE_RETRY_ATTEMPTS=3
TTE_RETRY_DELAY=300
TTE_QR_CODE_ENABLED=true
TTE_LOGGING_ENABLED=true
TTE_LOG_LEVEL=info

# Verifikasi keaslian dokumen ber-TTE (halaman "Cek Dokumen TTE").
# Default: aktif & lewat proxy /api/sign/verify (reuse Basic auth signing) — tidak perlu kredensial tambahan.
TTE_VERIFY_BSRE_ENABLED=true
E_SIGN_VERIFY_AUTH=basic
# Kosongkan untuk pakai default {E_SIGN_API_ENDPOINT}/api/sign/verify
E_SIGN_VERIFY_ENDPOINT=
E_SIGN_VERIFY_BASIC=
E_SIGN_VERIFY_TIMEOUT=30
# Opsional — hanya bila verify LANGSUNG ke BSrE (E_SIGN_VERIFY_AUTH=bearer|oauth):
E_SIGN_VERIFY_TOKEN=
E_SIGN_VERIFY_OAUTH_ENDPOINT=https://esign-bsre.bssn.go.id/oauth/token
E_SIGN_VERIFY_CLIENT_ID=
E_SIGN_VERIFY_CLIENT_SECRET=

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Kirim.Chat WhatsApp API
KIRIMCHAT_BASE_URL=https://api-prod.kirim.chat/api/v1/public
KIRIMCHAT_API_KEY=kc_live__XoUi9vlJ2bxBcs9r8NIFIZg9TJeEnMAiE5XcnGkR_o
KIRIMCHAT_ENABLED=true
KIRIMCHAT_VERIFICATION_NUMBER=628217611919

# Keep-alive Kirim.Chat: ping API berkala agar akun tetap aktif (tanpa kirim pesan)
# KEEPALIVE_FREQUENCY: everyMinute | hourly | daily | cron expr (mis. "0 8 * * *")
KEEPALIVE_ENABLED=true
KEEPALIVE_FREQUENCY=daily
KEEPALIVE_TIME=06:00

# Backup database mingguan otomatis
# BACKUP_DAY: 0=Minggu, 1=Senin, ... 6=Sabtu | BACKUP_TIME: 'HH:MM' (zona config app.timezone)
# BACKUP_KEEP: jumlah backup terbaru yang disimpan (1 per minggu)
BACKUP_DAY=0
BACKUP_TIME=03:00
BACKUP_KEEP=8

# Pemangkasan activity_log mingguan (batasi jumlah baris, hapus yang terlama)
# ACTIVITY_LOG_MAX_ROWS: batas maksimum baris yang dipertahankan
# ACTIVITY_LOG_PRUNE_DAY/TIME: jadwal (default Minggu 04:00); set ENABLED=false untuk mematikan
ACTIVITY_LOG_PRUNE_ENABLED=true
ACTIVITY_LOG_MAX_ROWS=10000
ACTIVITY_LOG_PRUNE_DAY=0
ACTIVITY_LOG_PRUNE_TIME=05:00

